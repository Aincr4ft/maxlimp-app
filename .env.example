# Copia este archivo como ".env" (sin ".example") y completa tus datos reales.
# El archivo ".env" NUNCA debe subirse a git (ya está en .gitignore).
#
# IMPORTANTE: usa el MISMO host/usuario/password de Railway que ya tienes
# para Auratec, pero con un DB_NAME NUEVO (p. ej. "maxlimp") para no mezclar
# las tablas de ambos proyectos en la misma base de datos. Puedes crear una
# base de datos nueva dentro del mismo servicio MySQL de Railway sin costo
# adicional, o levantar un plugin MySQL nuevo si prefieres separarlo del todo.

DB_HOST=tu-host-de-railway.proxy.rlwy.net
DB_PORT=puerto-de-railway
DB_USER=root
DB_PASSWORD=tu-password-de-railway
DB_NAME=maxlimp
